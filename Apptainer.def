Bootstrap: docker
From: condaforge/miniforge3:25.3.0-3

%labels
    org.opencontainers.image.title popgenVCF
    org.opencontainers.image.description Reproducible population-genomics toolkit for VCF data
    org.opencontainers.image.source https://github.com/duceppemo/popgenVCF
    org.opencontainers.image.licenses MIT

%files
    . /opt/popgenVCF

%environment
    export PATH=/opt/conda/envs/popgenvcf/bin:$PATH
    export CONDA_DEFAULT_ENV=popgenvcf
    export R_ENVIRON_USER=/dev/null
    export R_PROFILE_USER=/dev/null
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export HOME=/tmp

%post
    set -eu
    df -h / || true
    apt-get update
    apt-get install -y --no-install-recommends texlive-xetex lmodern
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    df -h / || true

    mamba env create --file /opt/popgenVCF/inst/conda/environment.yml
    mamba clean --all --yes
    df -h / || true
    export PATH=/opt/conda/envs/popgenvcf/bin:$PATH
    export CONDA_DEFAULT_ENV=popgenvcf
    export R_ENVIRON_USER=/dev/null
    export R_PROFILE_USER=/dev/null
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    cd /opt/popgenVCF
    # See NEWS.md / ROADMAP.md: a 2026-08-18 apptainer.yml run failed here
    # linking gdsfmt's vendored liblzma with no captured error text, twice
    # in a row. Disk exhaustion and a toolchain/C-standard mismatch were
    # both ruled out with real evidence (df showed 83-86GB free throughout;
    # an identical local rebuild used the identical -std=gnu23 toolchain
    # and succeeded with byte-identical compiler command lines). The
    # remaining, unruled-out difference is build parallelism: the local
    # repro ran without an explicit -j, while this runner's default make
    # concurrency can race against xz-5.2.9's own bundled (old, vendored)
    # Makefile if it is missing an explicit dependency edge -- a
    # well-documented failure class for exactly this signature (every
    # individual compile reports success; only the final link fails,
    # silently). MAKEFLAGS=-j1 forces serial compilation for just this
    # step as the standard mitigation; df stays in place so a recurrence
    # is still real evidence, not another silent Error 1.
    df -h / || true
    MAKEFLAGS=-j1 Rscript inst/scripts/install-bioconductor.R
    df -h / || true
    R CMD INSTALL .
    Rscript -e 'stopifnot(as.character(packageVersion("popgenVCF")) == read.dcf("DESCRIPTION")[1, "Version"])'
    Rscript -e 'x <- popgenVCF::run_scientific_validation(integration = TRUE, threads = 4); stopifnot(x$passed)'
    Rscript -e 'x <- popgenVCF::run_population_structure_validation(integration = TRUE); stopifnot(x$passed)'
    install -m 0755 docker/entrypoint.sh /usr/local/bin/popgenvcf
    mkdir -p /data
    chmod 0777 /data

%runscript
    exec /usr/local/bin/popgenvcf "$@"

%test
    xelatex --version >/dev/null
    Rscript -e 'stopifnot(requireNamespace("popgenVCF", quietly = TRUE))'
    /usr/local/bin/popgenvcf --help >/dev/null

%help
    popgenVCF Apptainer image

    Bind an analysis directory to /data and pass the regular popgenVCF CLI options:

      apptainer run --bind "$PWD:/data" popgenvcf.sif --config /data/analysis.yml
